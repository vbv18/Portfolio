PORT=3010
CLIENT_ORIGIN=http://localhost:5173

# Gemini API Key (Required for AI Portfolio Terminal)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# SMTP credentials — never commit real values.
# Works with any SMTP provider: Gmail (app password), Resend, SendGrid, AWS SES, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where contact-form messages are delivered, and what "From" address to send as.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
